# ------------------------------------------------------------
packages/
.nuget/
*.nupkg
*.snupkg

# Keep dependency lock/config files if present
!packages.lock.json
!NuGet.config

# ------------------------------------------------------------
# Local configuration / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

appsettings.Local.json
appsettings.local.json
appsettings.*.Local.json
appsettings.*.local.json
local.settings.json
