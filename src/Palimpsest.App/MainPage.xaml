<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Palimpsest_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="7">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="Palimpsest" />
            <TextBlock MaxWidth="820" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="抽取论文正文与附录内容，再按语义段落翻译为简体中文。图、表、公式、Caption 与 References 保持原样。" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="DropZone" Grid.Row="1" MinHeight="190" AllowDrop="True" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
            <Grid Padding="28">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="34" Glyph="&#xE8A5;" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Text="拖入一篇英文论文 PDF" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Text="或从本机选择文件；原 PDF 不会上传到 Palimpsest 服务器" />
                    <Button HorizontalAlignment="Center" Click="OpenPdfButton_Click" Content="选择 PDF" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="当前任务" />
                    <TextBlock x:Name="PdfPathText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚未选择 PDF" TextWrapping="Wrap" />
                    <ProgressBar x:Name="InspectorProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Text="等待输入" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="AnalyzeButton" IsEnabled="False" Click="AnalyzeButton_Click" Content="分析论文结构" />
                        <Button x:Name="OpenOutputButton" IsEnabled="False" Click="OpenOutputButton_Click" Content="打开调试输出" />
                        <Button x:Name="OpenTranslationButton" IsEnabled="False" Click="OpenTranslationButton_Click" Content="打开中文 PDF" />
                    </StackPanel>
                    <ProgressBar x:Name="TranslationProgress" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="TranslationStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚未开始翻译" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="翻译" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="默认免费使用，不需要登录或 API Key；也可以接入任意 OpenAI / Anthropic 兼容的大模型接口。" TextWrapping="Wrap" />

                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="翻译引擎" />
                        <ComboBox x:Name="ProviderCombo" SelectedIndex="0" SelectionChanged="ProviderCombo_SelectionChanged">
                            <ComboBoxItem Content="免费翻译（自动）" Tag="free-auto" />
                            <ComboBoxItem Content="Microsoft/Bing 翻译（免费）" Tag="bing-free" />
                            <ComboBoxItem Content="腾讯 TranSmart（免费）" Tag="transmart-free" />
                            <ComboBoxItem Content="Google 翻译（免费）" Tag="google-free" />
                            <ComboBoxItem Content="大模型 API（OpenAI 兼容）" Tag="llm-openai" />
                            <ComboBoxItem Content="大模型 API（Anthropic 兼容）" Tag="llm-anthropic" />
                        </ComboBox>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="免费接口属于网页/兼容接口，没有官方 SLA；自动模式会在服务限流或不可用时切换到下一个免费引擎。" TextWrapping="Wrap" />

                        <StackPanel x:Name="LlmApiPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="LlmProtocolText" FontWeight="SemiBold" Text="大模型 API" />
                            <TextBox x:Name="LlmBaseUrlBox" Header="Base URL" PlaceholderText="例如 https://api.openai.com/v1" />
                            <TextBox x:Name="LlmModelBox" Header="Model" PlaceholderText="例如 gpt-5.6 / deepseek-chat / claude-sonnet-..." />
                            <PasswordBox x:Name="LlmApiKeyBox" Header="API Key" PlaceholderText="API Key；本地无鉴权接口可以留空" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="SaveLlmProfileButton_Click" Content="保存接口配置" />
                                <Button Click="ClearLlmApiKeyButton_Click" Content="清除 Key" />
                                <TextBlock x:Name="LlmCredentialStateText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="未保存" />
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="URL 可以填写 /v1 级 Base URL，也可以直接填写完整的 /chat/completions 或 /messages 地址。Key、URL、Model 均只保存在本机；配置使用 Windows DPAPI 加密。" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button x:Name="TranslateButton" Margin="0,6,0,0" IsEnabled="False" Click="TranslateButton_Click" Content="翻译正文与附录" HorizontalAlignment="Stretch" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="支持断点续翻：译文先写入 PaperIR/缓存，随后自动排回原论文版式并导出可复制、可搜索的中文 PDF。" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
